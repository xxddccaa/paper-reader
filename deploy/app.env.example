# Documentation only. manage.py init generates actual secrets in runtime/config/app.env.
# Never copy production credentials into the engineering tree.
PAPER_READER_DATABASE_URL=postgresql+psycopg://paper_reader:GENERATE_RANDOM_PASSWORD@postgres:5432/paper_reader
PAPER_READER_ENCRYPTION_KEY=GENERATE_FERNET_KEY
POSTGRES_USER=paper_reader
POSTGRES_PASSWORD=GENERATE_RANDOM_PASSWORD
POSTGRES_DB=paper_reader
PAPER_READER_BIND_HOST=127.0.0.1
PAPER_READER_PORT=8000
PAPER_READER_UID=10001
PAPER_READER_GID=10001
PAPER_READER_SECURE_COOKIE=false
PAPER_READER_ALLOW_PRIVATE_MODELS=false
PAPER_READER_PUBLIC_ORIGIN=http://localhost:8000
PAPER_READER_SESSION_HOURS=24
PAPER_READER_UPLOAD_MAX_BYTES=52428800
PAPER_READER_LEASE_SECONDS=60
PAPER_READER_JOB_TIMEOUT_SECONDS=1200
PAPER_READER_MAX_ATTEMPTS=2
PAPER_READER_MAX_TOOL_CALLS=160
PAPER_READER_MAX_RUNNING_JOBS=2
PAPER_READER_MAX_JOBS_PER_WORKSPACE=1
PAPER_READER_INSTALL_DOCLING=true
PAPER_READER_DOCLING_ENABLED=0
PAPER_READER_DOCLING_OCR_ENABLED=0
PAPER_READER_DOCLING_ARTIFACTS_PATH=/runtime/cache/docling/models
